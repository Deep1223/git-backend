# Copy to `.env` for local runs. On Railway, set the same keys in the service Variables tab.
#
# MongoDB: Atlas (mongodb+srv://...) or Railway Mongo (mongodb://...)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/common-project

# CORS: your dashboard URL(s), comma-separated if multiple
FRONTEND_URL=http://localhost:3000

# Optional; Railway sets PORT automatically
# PORT=5000
